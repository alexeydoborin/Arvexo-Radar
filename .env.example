# Copy to .env and adjust. Never commit the real .env (see docs/16-security.md SEC-09).

ARVEXO_ENVIRONMENT=demo
ARVEXO_AUTH_MODE=demo

POSTGRES_USER=arvexo
POSTGRES_PASSWORD=arvexo
POSTGRES_DB=arvexo_radar
ARVEXO_DATABASE_URL=postgresql+asyncpg://arvexo:arvexo@db:5432/arvexo_radar

ARVEXO_STORAGE_PATH=/data/storage

ARVEXO_LLM_PROVIDER_MODE=mock
# Only needed when ARVEXO_LLM_PROVIDER_MODE=bothub:
ARVEXO_BOTHUB_API_KEY=
ARVEXO_BOTHUB_BASE_URL=https://openai.bothub.chat/v1
ARVEXO_BOTHUB_MODEL=gemini-2.5-flash
ARVEXO_LLM_TIMEOUT_SECONDS=30
ARVEXO_LLM_MAX_RETRIES=1
# Cost controls: at most 3 masked excerpts x 400 chars and 640 output tokens per request.
ARVEXO_LLM_MAX_SAMPLES=3
ARVEXO_LLM_MAX_SAMPLE_CHARS=400
ARVEXO_LLM_MAX_OUTPUT_TOKENS=640

# OpenAI-compatible proxy. The base URL includes the API version prefix.
ARVEXO_LLM_PROXY_BASE_URL=https://api.openai.com/v1
ARVEXO_LLM_PROXY_API_KEY=
ARVEXO_LLM_PROXY_TIMEOUT_SECONDS=60
# Required in production. Generate a long random value and never expose it to clients.
ARVEXO_ANALYTICS_USER_HASH_SALT=change-this-to-a-long-random-server-side-secret
ARVEXO_ANALYTICS_CURRENCY=RUB

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Arvexo Account SSO. The client secret must match the `arvexo-radar`
# client registered in Arvexo Account and must never be exposed as NEXT_PUBLIC_*.
ARVEXO_ACCOUNT_API_URL=http://localhost:8032
ARVEXO_RADAR_CLIENT_ID=arvexo-radar
ARVEXO_RADAR_CLIENT_SECRET=dev_radar_secret
# Optional locally. Required in production and must be the public HTTPS URL.
# ARVEXO_RADAR_CALLBACK_URL=https://radar.arvexo.ru/auth/callback
ARVEXO_RADAR_SESSION_SECRET=replace-with-at-least-32-random-characters

# Only needed on the deploy server, for docker-compose.prod.yml
# (see .github/workflows/cd.yml / docs/22-ci-cd.md). Leave unset locally.
API_IMAGE=
WEB_IMAGE=

# Production-only (docker-compose.prod.yml). Loopback host ports behind
# nginx — 80/443/3000/8000 already taken by other services on the box.
API_HOST_PORT=38000
WEB_HOST_PORT=38080

# Production-only: origin fronted by nginx, must match nginx's server_name.
# ARVEXO_CORS_ORIGINS=["https://radar.arvexo.ru"]

# NOTE: NEXT_PUBLIC_API_BASE_URL is NOT read from this .env in production.
# Next.js inlines NEXT_PUBLIC_* into the client bundle at `npm run build`
# time, which already happened when the image was built in CI — setting it
# here has no effect on docker-compose.prod.yml. It's passed as a
# --build-arg in .github/workflows/cd.yml instead; change it there if the
# deploy domain ever changes.
